---
import Base from '../layouts/Base.astro';
import privacy from '../data/privacy.json';

/*
 * A generic policy, written to describe exactly what this site does rather
 * than a template of clauses it does not need (CLAUDE.md 11). Every third
 * party the code actually talks to is named — the form-delivery service, the
 * postcode lookup, the analytics tool — because naming them is the point of
 * the exercise.
 *
 * What is left as `[AWAITING …]` is the handful of things only the business
 * can state: who the controller is, how long enquiries are kept, and which
 * transfer safeguards its providers rely on. Guessing those would be
 * inventing business facts, and they are commitments in law, not copy.
 *
 * The prose lives in `privacy.json` so the client can edit it without
 * touching a component (rule 2.9). Paragraphs and list items are rendered as
 * HTML so a sentence can carry a link — the source is our own data file, not
 * anything a visitor can supply.
 */
const isPlaceholder = (value: string) => value.startsWith('[AWAITING');
---

<Base title={privacy.title} description={privacy.description}>
  <div class="mx-auto max-w-page px-gutter pt-section pb-section">
    <h1 class="max-w-content font-serif text-display text-ink">{privacy.heading}</h1>

    <p class="mt-4 max-w-content text-sm text-ink-subtle">
      {isPlaceholder(privacy.updated) ? privacy.updated : `In force from ${privacy.updated}`}
    </p>

    {/* Visible on purpose: the page is a draft until the business completes
        the marked fields, and a policy that looks finished but is not is the
        one thing worse than an obvious draft. */}
    <div class="mt-6 max-w-content rounded-sm border border-line-strong bg-surface p-6">
      <p class="text-sm text-ink">{privacy.review}</p>
    </div>

    <p class="mt-10 max-w-content text-ink-muted">{privacy.intro}</p>

    {
      privacy.sections.map((section) => (
        <section class="mt-10">
          <h2 class="max-w-content font-serif text-xl text-ink">{section.heading}</h2>

          {'listIntro' in section && (
            <p class="mt-4 max-w-content text-ink-muted">{section.listIntro}</p>
          )}

          {'list' in section && (
            <ul class="mt-4 max-w-content list-disc space-y-2 pl-5 text-ink-muted [&_a]:text-accent [&_a]:underline [&_a]:underline-offset-4">
              {section.list?.map((item) => <li set:html={item} />)}
            </ul>
          )}

          {section.paragraphs?.map((paragraph) => (
            <p
              class="mt-4 max-w-content text-ink-muted [&_a]:text-accent [&_a]:underline [&_a]:underline-offset-4"
              set:html={paragraph}
            />
          ))}
        </section>
      ))
    }
  </div>
</Base>
