---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import BrandMarquee from '../components/home/BrandMarquee.astro';
import HowItWorks from '../components/home/HowItWorks.astro';
import BrandStrip from '../components/home/BrandStrip.astro';
import About from '../components/home/About.astro';
import copy from '../data/copy.json';

/*
 * Phase 7. Sells the service; the wizard does the work. Section ids match the
 * anchors in `site.nav`, and the footer carries #contact.
 *
 * Ships no JavaScript of its own — the nav toggle and the WhatsApp button are
 * the whole budget for this page (CLAUDE.md 10.2).
 *
 * The hero headline, supporting line and the About paragraphs are the client's
 * to write and render as [AWAITING COPY] markers until they land. The
 * positioning question (premium specialist or general electricals) is also
 * still open, so the restrained direction holds — it degrades gracefully
 * either way (CLAUDE.md 9.1, MISSING-ASSETS.md 1.2).
 */
---

<Base title={copy.home.title} description={copy.home.description}>
  <Hero />
  <BrandMarquee />
  <HowItWorks />
  <BrandStrip />
  <About />
</Base>
