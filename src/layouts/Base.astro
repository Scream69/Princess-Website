---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Analytics from '../components/Analytics.astro';
import site from '../data/site.json';
import { isPlaceholder } from '../data/site';
import StructuredData from '../components/StructuredData.astro';
import interUrl from '../assets/fonts/inter-400-latin.woff2?url';
import frauncesUrl from '../assets/fonts/fraunces-600-latin.woff2?url';

interface Props {
  title: string;
  description: string;
  /** Set false on /order so the wizard page keeps a quieter chrome. */
  showNavLinks?: boolean;
  /** 404 only: keep it out of the index without touching the other pages. */
  noindex?: boolean;
}

const { title, description, showNavLinks = true, noindex = false } = Astro.props;

/*
 * Pages supply what the page is; the business name is appended here. That
 * keeps the trading name in site.json alone — copy.json never spells it out,
 * so a change of name is a one-line change — and it is left off entirely
 * while the name is still a placeholder, rather than shipping a marker into
 * every browser tab and search result.
 */
const pageTitle = isPlaceholder(site.name) ? title : `${title} · ${site.name}`;

// Astro.site is unset until the live domain is confirmed; canonical and
// Open Graph URLs are emitted only once it is, rather than guessed.
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />

    {/* The crown from the client's own lockup, cut out by measurement in
        scripts/make-icons.mjs. The wordmark is left off deliberately: at 32px
        "PRINCES ELECTRONICS" is three grey smudges. */}
    <link rel="icon" href="/favicon.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {/* Every page renders body copy and a serif heading above the fold —
        preload those two so first paint doesn't wait on the CSS to be
        parsed before the font request even starts. Inter 500 (labels,
        buttons) is left to load on its own; preloading every weight just
        makes them compete with each other. */}
    <link rel="preload" as="font" type="font/woff2" href={interUrl} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={frauncesUrl} crossorigin />

    {/*
      Absolute, or not at all. Every platform that reads og:image fetches it
      server-side with no page context, so a root-relative path resolves
      against their host and 404s — and a broken share card renders worse than
      none. `site` is unset until the domain lands (MISSING-ASSETS.md 5), so
      this appears with the canonical URL and not before.
    */}
    {
      canonical && (
        <>
          <meta property="og:image" content={new URL('/og-image.png', Astro.site).href} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={`${site.name} — ${site.tagline}`} />
        </>
      )
    }
    <StructuredData />
    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Nav showLinks={showNavLinks} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />
  </body>
</html>
