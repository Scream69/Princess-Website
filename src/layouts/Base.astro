---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Analytics from '../components/Analytics.astro';
import site from '../data/site.json';
import { isPlaceholder } from '../data/site';
import StructuredData from '../components/StructuredData.astro';

interface Props {
  title: string;
  description: string;
  /** Set false on /order so the wizard page keeps a quieter chrome. */
  showNavLinks?: boolean;
  /** 404 only: keep it out of the index without touching the other pages. */
  noindex?: boolean;
}

const { title, description, showNavLinks = true, noindex = false } = Astro.props;

/*
 * Pages supply what the page is; the business name is appended here. That
 * keeps the trading name in site.json alone — copy.json never spells it out,
 * so a change of name is a one-line change — and it is left off entirely
 * while the name is still a placeholder, rather than shipping a marker into
 * every browser tab and search result.
 */
const pageTitle = isPlaceholder(site.name) ? title : `${title} · ${site.name}`;

// Astro.site is unset until the live domain is confirmed; canonical and
// Open Graph URLs are emitted only once it is, rather than guessed.
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {/* No og:image tag until a real 1200x630 share image exists — a broken
        one renders worse in a share card than none (MISSING-ASSETS.md 2). */}
    <StructuredData />
    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Nav showLinks={showNavLinks} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />
  </body>
</html>
