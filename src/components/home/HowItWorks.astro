---
import { featuredBrands } from '../../data/brands';
import copy from '../../data/copy.json';
import site from '../../data/site.json';

/*
 * The three steps, as a scroll-driven sequence at desktop width: the text
 * column holds still while the figure beside it changes, and a rail along
 * the bottom counts 01 / 02 / 03.
 *
 * Deliberate decisions, in roughly the order they will be questioned:
 *
 * **It ships JavaScript, and the home page was meant not to.** CLAUDE.md
 * 10.2 says the home page ships effectively nothing beyond the nav toggle.
 * This adds one IntersectionObserver — around thirty lines, no scroll
 * listener, firing only when a sentinel crosses the middle of the viewport.
 * The cost is measured in the README rather than assumed.
 *
 * **Without JavaScript it is the old three-column list.** The sticky stage,
 * the tall scroll track and the figures exist only under `[data-enhanced]`,
 * which the script sets once it has found everything it needs. Nothing a
 * customer must read to understand the model is behind a script.
 *
 * **Mobile keeps the list too.** A sticky stage on a short screen means
 * scrolling a long way past a frozen panel, which is worse than reading
 * three short blocks, so the whole sequence is gated at `lg`.
 *
 * **The figures illustrate our own product, not products we sell.** Real
 * brand names from brands.json, the real first question from copy.json, the
 * real reference format. No model number, no price, no specification and no
 * manufacturer logo — none of which may be invented (rules 2.2, 2.3).
 */
const { process } = copy;
const { howItWorks } = copy.home;
const { figures } = howItWorks;

// Six real names for the step 1 figure; one of them is shown as chosen.
const tiles = featuredBrands.slice(0, 6);
const CHOSEN = 3;
---

<section id="how-it-works" class="border-y border-line bg-surface">
  <div class="mx-auto max-w-page px-gutter py-section">
    <div class="stage" data-stage>
      {/* Sentinels: something for the observer to cross. They add no height
          of their own — the track's height comes from the CSS. */}
      <div class="sentinels" aria-hidden="true">
        {process.steps.map((_step, index) => <div data-sentinel={index + 1} />)}
      </div>

      {/*
        Everything is inside the sticky panel: the heading above, the button
        below, and only the band between them changes. Previously the heading
        scrolled away and the button slid up into view part-way through the
        sequence — the section has to hold still and let its middle move.
      */}
      <div class="viewport">
        <header class="band-head">
          <span aria-hidden="true" class="mb-5 block h-0.5 w-10 bg-gold"></span>
          <h2 class="max-w-content font-serif text-heading text-ink">{howItWorks.heading}</h2>
          <p class="mt-4 max-w-content text-ink-muted">{howItWorks.intro}</p>
        </header>

        <div class="band grid gap-12 lg:grid-cols-2 lg:items-center lg:gap-16">
          <ol class="steps m-0 list-none p-0">
            {
              process.steps.map((step, index) => (
                <li class="step" data-step={index + 1}>
                  <span aria-hidden="true" class="block h-0.5 w-8 bg-gold" />
                  <span aria-hidden="true" class="mt-4 block font-serif text-3xl text-gold-ink">
                    {index + 1}
                  </span>
                  <h3 class="mt-3 font-serif text-xl text-ink">{step.title}</h3>
                  <p class="mt-2 max-w-content text-ink-muted">{step.detail}</p>
                </li>
              ))
            }
          </ol>

          {/* Decorative: everything here is said properly in the column on
              the left, so there is nothing for a screen reader to gain. */}
          <div class="figures" aria-hidden="true">
            <div class="figure" data-figure="1">
              <p class="figure-label">{figures.brandsLabel}</p>
              <div class="tiles">
                {
                  tiles.map((brand, index) => (
                    <div
                      class:list={['tile', index === CHOSEN && 'tile-chosen']}
                      style={`--i:${index}`}
                    >
                      <span>{brand.name}</span>
                      {index === CHOSEN && <em class="tile-hint">{figures.brandHint}</em>}
                    </div>
                  ))
                }
              </div>
            </div>

            <div class="figure" data-figure="2">
              <p class="figure-label">{figures.addressLabel}</p>
              <div class="bar bar-address">
                <span class="dot"></span>
                <span class="url">
                  {tiles[CHOSEN]?.url.replace('https://', '')}<span class="path"
                    >{figures.addressPath}</span
                  >
                </span>
                <span class="flag flag-copied">{figures.copied}</span>
              </div>

              <p class="figure-label mt-6">{figures.pasteLabel}</p>
              <div class="bar bar-paste">
                <span class="caret"></span>
                <span class="chip">{figures.recognised}</span>
              </div>
            </div>

            <div class="figure" data-figure="3">
              <p class="figure-label">{figures.detailsLabel}</p>
              <div class="bubble">{copy.order.step3.questions.name.question}</div>
              <div class="answer"><span class="typed"></span></div>

              <div class="receipt">
                <p class="figure-label">{figures.referenceLabel}</p>
                <p class="reference">
                  ENQ-{[0, 1, 2, 3, 4].map((index) => (
                    <span class="mask" style={`--i:${index}`}>&#9679;</span>
                  ))}
                </p>
                <p class="promise">{site.responsePromise}</p>
              </div>
            </div>
          </div>
        </div>

        <div class="rail" aria-hidden="true">
          <div class="rail-line"><span class="rail-fill" data-fill></span></div>
          <div class="rail-numbers">
            {process.steps.map((_step, index) => <span data-number={index + 1}>0{index + 1}</span>)}
          </div>
        </div>

        <a
          href={site.cta.href}
          class="cta mt-10 inline-flex min-h-touch items-center justify-self-start rounded-sm bg-accent px-6 font-medium text-accent-contrast transition-colors hover:bg-accent-hover"
        >
          {howItWorks.cta}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* --- unenhanced, and every screen below lg: three plain blocks -------- */

  .sentinels,
  .figures,
  .rail {
    display: none;
  }

  .steps {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 48rem) {
    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* --- the scroll sequence ---------------------------------------------- */

  @media (min-width: 64rem) {
    /*
     * `--panel` is the height of the whole composition — heading, band, rail
     * and button — because all of it is sticky now. Everything else derives
     * from it: the track is the panel plus three steps' worth of scrolling,
     * and the sentinels stop one panel short of the bottom, which is where
     * the panel releases.
     */
    [data-enhanced].stage {
      --panel: 37rem;
      /* Scroll distance per step. Long enough that each figure has time to
         play out before the next step takes over. */
      --step-scroll: 56vh;

      position: relative;
      min-height: calc(var(--panel) + (var(--step-scroll) * 3));
    }

    /*
     * The sentinels stop one viewport short of the bottom, because that is
     * where the sticky panel releases. Spanning the full track put step 3's
     * sentinel past the release point: the text switched after the panel had
     * already scrolled away, so the last step was never seen in place.
     */
    [data-enhanced] .sentinels {
      display: block;
      position: absolute;
      top: 0;
      right: 0;
      left: 0;
      /* The panel plus the offset it sticks at: that sum is where it lets
         go, and the sentinels must not run past it or the last step
         activates after the panel has left. */
      bottom: calc(var(--panel) + 5.5rem);
    }

    [data-enhanced] .sentinels > div {
      height: 33.3333%;
    }

    [data-enhanced] .viewport {
      position: sticky;
      /* Clear the fixed nav. */
      top: 5.5rem;
      display: grid;
      align-content: start;
      min-height: var(--panel);
    }

    /* The two fixed ends of the composition. Neither moves while the band
       between them cycles. */
    [data-enhanced] .band-head {
      margin-bottom: 3rem;
    }

    [data-enhanced] .cta {
      align-self: end;
    }

    /* The three texts share one cell and cross-fade. */
    [data-enhanced] .steps {
      grid-template-columns: 1fr;
      gap: 0;
    }

    [data-enhanced] .band {
      min-height: 13rem;
    }

    [data-enhanced] .step {
      grid-area: 1 / 1;
      opacity: 0;
      transform: translateY(0.75rem);
      transition:
        opacity 400ms ease,
        transform 400ms ease;
    }

    [data-enhanced] .step[data-active] {
      opacity: 1;
      transform: none;
    }

    [data-enhanced] .figures {
      display: grid;
      min-height: 13rem;
    }

    [data-enhanced] .figure {
      grid-area: 1 / 1;
      align-self: center;
      opacity: 0;
      transform: translateY(1rem);
      transition:
        opacity 450ms ease,
        transform 450ms ease;
    }

    [data-enhanced][data-visible] .figure[data-active] {
      opacity: 1;
      transform: none;
    }

    [data-enhanced] .rail {
      display: block;
      align-self: end;
      margin-top: 2.5rem;
    }
  }

  /* --- the figures ------------------------------------------------------ */

  .figure-label {
    margin: 0 0 0.75rem;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-subtle);
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .tile {
    display: flex;
    min-height: 4.5rem;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    background-color: var(--color-surface);
    padding: 0.75rem 0.5rem;
    font-family: var(--font-serif);
    color: var(--color-ink);
    text-align: center;
  }

  /* The lift the real brand card does on hover, held still. */
  .tile-chosen {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }

  .tile-hint {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-style: normal;
    color: var(--color-ink-subtle);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-sm);
    background-color: var(--color-surface);
    padding: 0.75rem 0.875rem;
  }

  .dot {
    width: 0.5rem;
    height: 0.5rem;
    flex-shrink: 0;
    border-radius: 9999px;
    background-color: var(--color-gold);
  }

  .url {
    overflow: hidden;
    font-size: 0.875rem;
    color: var(--color-ink);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .path {
    color: var(--color-ink-subtle);
  }

  .flag {
    margin-left: auto;
    flex-shrink: 0;
    border-radius: var(--radius-sm);
    background-color: var(--color-gold-ink);
    padding: 0.125rem 0.5rem;
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    color: var(--color-surface);
  }

  .typed {
    display: block;
    height: 100%;
    width: 60%;
    border-right: 1px solid var(--color-accent);
    background-color: var(--color-canvas);
    transform-origin: left;
  }

  .caret {
    width: 1px;
    height: 1.125rem;
    flex-shrink: 0;
    background-color: var(--color-accent);
  }

  .chip {
    border-radius: var(--radius-sm);
    background-color: var(--color-accent);
    padding: 0.25rem 0.625rem;
    font-size: 0.75rem;
    color: var(--color-accent-contrast);
  }

  .bubble {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    background-color: var(--color-canvas);
    padding: 0.75rem 0.875rem;
    font-size: 0.9375rem;
    color: var(--color-ink);
  }

  .answer {
    overflow: hidden;
    margin-top: 0.5rem;
    margin-left: 20%;
    height: 2.5rem;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-sm);
  }

  .receipt {
    margin-top: 1.5rem;
    border-top: 2px solid var(--color-gold);
    padding-top: 1rem;
  }

  .reference {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.5rem;
    letter-spacing: 0.08em;
    color: var(--color-ink);
  }

  .mask {
    display: inline-block;
    color: var(--color-ink-subtle);
  }

  .promise {
    margin: 0.5rem 0 0;
    font-size: 0.8125rem;
    color: var(--color-ink-muted);
  }

  /* --- the rail --------------------------------------------------------- */

  .rail-line {
    height: 1px;
    background-color: var(--color-line);
  }

  .rail-fill {
    display: block;
    height: 1px;
    width: 33.3333%;
    background-color: var(--color-accent);
    transition: width 450ms ease;
  }

  .rail-numbers {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 0.75rem;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--color-ink-subtle);
  }

  .rail-numbers span {
    text-align: center;
    transition: color 300ms ease;
  }

  .rail-numbers span[data-active] {
    color: var(--color-ink);
  }

  /* --- each figure plays its step ---------------------------------------
   *
   * The animations hang off `[data-active]`, so they restart every time a
   * step is scrolled back to: removing the attribute cancels them, adding it
   * runs them again. Only opacity and transform, so none of it costs layout.
   *
   * They are also gated on `[data-visible]`, which the script sets when the
   * section reaches the screen. Without that, step one is marked active at
   * page load and its sequence plays to an empty room — by the time anyone
   * scrolls down to look, it finished long ago and the figure appears to be
   * a static picture. That is exactly what it looked like.
   */

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(0.875rem);
    }
  }

  @keyframes pop {
    from {
      opacity: 0;
      transform: scale(0.9);
    }
  }

  @keyframes select {
    from {
      border-color: var(--color-line);
      transform: none;
    }
    55% {
      transform: translateY(-7px);
    }
  }

  @keyframes recede {
    to {
      opacity: 0.45;
    }
  }

  /* A reveal rather than a width change: clip-path costs no layout. */
  @keyframes type {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes fill {
    from {
      transform: scaleX(0);
    }
  }

  @keyframes sweep {
    from {
      transform: scaleX(0);
    }
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @keyframes flash {
    0%,
    100% {
      border-color: var(--color-line-strong);
    }
    40% {
      border-color: var(--color-gold);
    }
  }

  @media (min-width: 64rem) {
    /* --- 1: the directory fills, then one brand is chosen --------------- */

    [data-enhanced][data-visible] .figure[data-active] .tile {
      animation: rise 480ms both;
      animation-delay: calc(var(--i) * 110ms);
    }

    [data-enhanced][data-visible] .figure[data-active] .tile-chosen {
      animation:
        rise 480ms both,
        select 620ms 900ms both;
    }

    /* The rest step back once the choice is made. */
    [data-enhanced][data-visible] .figure[data-active] .tile:not(.tile-chosen) {
      animation:
        rise 480ms calc(var(--i) * 110ms) both,
        recede 500ms 1000ms both;
    }

    [data-enhanced][data-visible] .figure[data-active] .tile-hint {
      animation: rise 420ms 1300ms both;
    }

    /* --- 2: the address types, is copied, then lands in the field ------- */

    [data-enhanced][data-visible] .figure[data-active] .bar-address {
      animation:
        rise 460ms both,
        flash 700ms 1500ms both;
    }

    [data-enhanced][data-visible] .figure[data-active] .url {
      animation: type 1100ms 320ms steps(26, end) both;
    }

    [data-enhanced][data-visible] .figure[data-active] .flag-copied {
      animation: pop 340ms 1600ms both, rise 400ms 2300ms reverse both;
    }

    [data-enhanced][data-visible] .figure[data-active] .bar-paste {
      animation: rise 460ms 2100ms both;
    }

    [data-enhanced][data-visible] .figure[data-active] .caret {
      animation:
        rise 220ms 2100ms both,
        blink 280ms 2300ms steps(1) 3;
    }

    [data-enhanced][data-visible] .figure[data-active] .chip {
      animation: pop 400ms 2900ms both;
    }

    /* --- 3: the question, the answer, then the reference resolves ------- */

    [data-enhanced][data-visible] .figure[data-active] .bubble {
      animation: rise 460ms both;
    }

    [data-enhanced][data-visible] .figure[data-active] .answer {
      animation: rise 460ms 600ms both;
    }

    [data-enhanced][data-visible] .figure[data-active] .typed {
      animation: fill 900ms 1000ms both;
    }

    [data-enhanced][data-visible] .figure[data-active] .receipt {
      animation: rise 480ms 2000ms both;
    }

    [data-enhanced][data-visible] .figure[data-active] .receipt::before {
      content: '';
      display: block;
      position: relative;
      top: -1rem;
      height: 2px;
      margin-bottom: -2px;
      background-color: var(--color-gold);
      transform-origin: left;
      animation: sweep 700ms 2200ms both;
    }

    [data-enhanced][data-visible] .figure[data-active] .reference {
      animation: rise 440ms 2500ms both;
    }

    /* The five characters of the reference arrive one at a time. */
    [data-enhanced][data-visible] .figure[data-active] .mask {
      animation: pop 300ms both;
      animation-delay: calc(2800ms + (var(--i) * 130ms));
    }

    [data-enhanced][data-visible] .figure[data-active] .promise {
      animation: rise 440ms 3500ms both;
    }
  }

  /*
   * Reduced motion keeps the sequence — the steps still change as you
   * scroll — but nothing moves or replays on its own.
   */
  @media (prefers-reduced-motion: reduce) {
    .step,
    .figure,
    .rail-fill,
    .rail-numbers span {
      transition: none !important;
    }

    .step,
    .figure {
      transform: none !important;
    }

    .figure *,
    .figure {
      animation: none !important;
    }
  }
</style>

<script>
  /*
   * One observer, three sentinels, no scroll listener: whichever sentinel is
   * crossing the middle of the viewport decides the active step.
   *
   * Everything it touches is presentational — `data-active` attributes and a
   * width — so if this never runs, the section is still the three-column
   * list it is without JavaScript.
   */
  const stage = document.querySelector<HTMLElement>('[data-stage]');
  const sentinels = stage?.querySelectorAll<HTMLElement>('[data-sentinel]');

  if (stage && sentinels?.length && 'IntersectionObserver' in window) {
    const steps = stage.querySelectorAll<HTMLElement>('[data-step]');
    const figures = stage.querySelectorAll<HTMLElement>('[data-figure]');
    const numbers = stage.querySelectorAll<HTMLElement>('[data-number]');
    const fill = stage.querySelector<HTMLElement>('[data-fill]');

    // Only now does the CSS switch to the sticky stage, so anything failing
    // above this line leaves the plain list rather than a broken half-state.
    stage.dataset.enhanced = '';

    let current = 0;

    const mark = (nodes: NodeListOf<HTMLElement>, key: string, step: number) => {
      for (const node of nodes) {
        if (Number(node.dataset[key]) === step) node.dataset.active = '';
        else delete node.dataset.active;
      }
    };

    const show = (step: number) => {
      if (step === current) return;
      current = step;
      mark(steps, 'step', step);
      mark(figures, 'figure', step);
      mark(numbers, 'number', step);
      if (fill) fill.style.width = `${(step / steps.length) * 100}%`;
    };

    show(1);

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const step = Number((entry.target as HTMLElement).dataset.sentinel);
          if (step) show(step);
        }
      },
      /*
       * A line across the top of the viewport, not the middle. The sentinels
       * tile the sticky range, so the one crossing the top edge is exactly
       * as far through the sequence as the reader is. Using the middle put
       * the steps half a screen out of phase — step 2 was showing before the
       * panel had finished arriving.
       */
      { rootMargin: '0px 0px -100% 0px', threshold: 0 },
    );

    for (const sentinel of sentinels) observer.observe(sentinel);

    /*
     * Whether the section is on screen at all. The figures' own animations
     * are gated on this, so step one plays when the reader arrives rather
     * than while the page is still at the top — and plays again if they
     * scroll away and come back.
     */
    new IntersectionObserver(
      ([entry]) => {
        if (entry?.isIntersecting) stage.dataset.visible = '';
        else delete stage.dataset.visible;
      },
      { threshold: 0 },
    ).observe(stage);
  }
</script>
