---
import { brands as allBrands } from '../../data/brands';
import copy from '../../data/copy.json';
import site from '../../data/site.json';
import HeroBackdrop from './HeroBackdrop.astro';

/*
 * The home page has five seconds to explain a model no other retailer uses:
 * you shop on the manufacturer's website, and we quote (CLAUDE.md 7). The
 * headline carries the client's promise, and the process line under it does
 * the explaining, so nobody has to infer how this works from a slogan.
 *
 * The right-hand column exists because a left-aligned hero leaves half the
 * screen empty at desktop width. The figure in it is read from brands.json
 * so it cannot drift, and the promise beneath it comes from site.json,
 * never computed (CLAUDE.md 8.5).
 *
 * It carried a second figure naming the buying group until the client asked
 * for that to come off the site — membership is not something they are in a
 * position to display. The About section made the same claim at greater
 * length and has been rewritten for the same reason.
 *
 * There were two blurred clearings behind the text for a while, painting the
 * page's colour back over the backdrop so nothing drifted under the copy.
 * They existed because the backdrop was brand names at the time, and words
 * crossing words is unreadable. The backdrop is now five faint arcs on plain
 * white, which the headline sits over without any help, so the clearings
 * have gone — along with the coupling that made the hero's background and
 * their fill one decision.
 */
const { hero } = copy.home;
---

{/* `relative` anchors the backdrop, `isolate` keeps its stacking context
    from reaching the fixed nav, and `overflow-hidden` contains rows that are
    deliberately wider than the page. */}
<section class="relative isolate overflow-hidden bg-surface">
  <HeroBackdrop />

  <div
    class="relative z-10 mx-auto grid max-w-page gap-12 px-gutter pt-section pb-section lg:grid-cols-[1fr_16rem] lg:gap-16"
  >
    <div>
      {/* The tagline, sized as a kicker rather than a second headline.
          Gold-ink rather than gold: this is read, not just seen. */}
      <p class="text-sm font-medium tracking-[0.14em] text-gold-ink uppercase">{hero.eyebrow}</p>

      <h1 class="mt-5 max-w-content font-serif text-display text-ink">{hero.headline}</h1>

      <p class="mt-8 max-w-content border-l-2 border-gold pl-4 text-ink">{hero.process}</p>

      {/* One call to action. The jump link to how-it-works came out with the
          supporting line; the nav still carries that anchor. */}
      <a
        href={site.cta.href}
        class="mt-10 inline-flex min-h-touch items-center rounded-sm bg-accent px-6 font-medium text-accent-contrast transition-colors hover:bg-accent-hover"
      >
        {site.cta.label}
      </a>
    </div>

    {/* `self-start` so the figure sits at the top of its column rather than
        stretching to the height of the headline beside it. */}
    <aside class="self-start lg:pt-2">
      <dl class="m-0">
        <div class="border-t-2 border-gold pt-4">
          <dt class="figures text-display-sm text-ink">{allBrands.length}</dt>
          <dd class="m-0 text-sm text-ink-muted">{hero.facts.brands}</dd>
        </div>
      </dl>

      <p class="mt-8 border-t border-line pt-4 text-sm text-ink-muted">{site.responsePromise}</p>
    </aside>
  </div>
</section>
