---
import { brands as allBrands } from '../../data/brands';
import copy from '../../data/copy.json';
import site from '../../data/site.json';
import { whatsappHref } from '../../data/site';
import WhatsAppIcon from '../WhatsAppIcon.astro';

/*
 * The home page has five seconds to explain a model no other retailer uses:
 * you shop on the manufacturer's website, and we quote (CLAUDE.md 7). The
 * headline carries the client's promise, and the process line under it does
 * the explaining, so nobody has to infer how this works from a slogan.
 *
 * The right-hand column exists because a left-aligned hero leaves half the
 * screen empty at desktop width. The figure in it is read from brands.json
 * so it cannot drift, and the promise beneath it comes from site.json,
 * never computed (CLAUDE.md 8.5).
 *
 * It carried a second figure naming the buying group until the client asked
 * for that to come off the site — membership is not something they are in a
 * position to display. The About section made the same claim at greater
 * length and has been rewritten for the same reason.
 *
 * The hero had an animated backdrop through several versions — drifting
 * brand names, then fine vertical fluting, then sweeping hairline arcs — and
 * two blurred clearings to keep the copy off whichever of them was running.
 * The client's decision on 2026-09-12 was plain white, so all of it is gone
 * and `HeroBackdrop.astro` with it. What is left needs no stacking context,
 * no overflow clipping and no `z-10` on the grid, because there is nothing
 * behind the text to sit in front of.
 *
 * Worth knowing before adding another: none of those versions failed on
 * taste. The names duplicated the strip 80px below, and the fluting and the
 * arcs each had to be found by measuring, because an animation can be
 * running perfectly and still read as a still page.
 */
const { hero } = copy.home;

/*
 * Null until a number is in site.json, and the button disappears with it
 * rather than rendering a dead wa.me link (see the note in site.ts). The
 * number landed 2026-09-15, so both buttons are live.
 */
const whatsapp = whatsappHref();
---

<section class="bg-surface">
  <div
    class="mx-auto grid max-w-page gap-12 px-gutter pt-section pb-section lg:grid-cols-[1fr_16rem] lg:gap-16"
  >
    <div>
      {/* The tagline, sized as a kicker rather than a second headline.
          Gold-ink rather than gold: this is read, not just seen. */}
      <p class="text-sm font-medium tracking-[0.14em] text-gold-ink uppercase">{hero.eyebrow}</p>

      <h1 class="mt-5 max-w-content font-serif text-display text-ink">{hero.headline}</h1>

      <p class="mt-8 max-w-content border-l-2 border-gold pl-4 text-ink">{hero.process}</p>

      {/*
        Two ways to start, with one of them clearly first. The quote button is
        the filled one because the enquiry form is what this page exists to
        feed (CLAUDE.md 1); WhatsApp is outlined, for the customer who would
        rather send a photo than fill anything in. Equal weight would make the
        page ask a question instead of giving a direction.
      */}
      <div class="mt-10 flex flex-wrap items-center gap-3">
        <a
          href={site.cta.href}
          class="inline-flex min-h-touch items-center rounded-sm bg-accent px-6 font-medium text-accent-contrast transition-colors hover:bg-accent-hover"
        >
          {site.cta.label}
        </a>

        {
          whatsapp && (
            <a
              href={whatsapp}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-touch items-center gap-2 rounded-sm border border-line-strong px-5 font-medium text-ink transition-colors hover:border-ink"
            >
              <WhatsAppIcon />
              <span>{copy.whatsapp.hero}</span>
            </a>
          )
        }
      </div>
    </div>

    {/* `self-start` so the figure sits at the top of its column rather than
        stretching to the height of the headline beside it. */}
    <aside class="self-start lg:pt-2">
      <dl class="m-0">
        <div class="border-t-2 border-gold pt-4">
          <dt class="figures text-display-sm text-ink">{allBrands.length}</dt>
          <dd class="m-0 text-sm text-ink-muted">{hero.facts.brands}</dd>
        </div>
      </dl>

      <p class="mt-8 border-t border-line pt-4 text-sm text-ink-muted">{site.responsePromise}</p>
    </aside>
  </div>
</section>
