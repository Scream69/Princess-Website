---
import { brands as allBrands } from '../../data/brands';
import copy from '../../data/copy.json';
import site from '../../data/site.json';
import HeroBackdrop from './HeroBackdrop.astro';

/*
 * The home page has five seconds to explain a model no other retailer uses:
 * you shop on the manufacturer's website, and we quote (CLAUDE.md 7). The
 * headline carries the client's promise, and the process line under it does
 * the explaining, so nobody has to infer how this works from a slogan.
 *
 * The right-hand column exists because a left-aligned hero leaves half the
 * screen empty at desktop width. The figure in it is read from brands.json
 * so it cannot drift, and the promise beneath it comes from site.json,
 * never computed (CLAUDE.md 8.5).
 *
 * It carried a second figure naming the buying group until the client asked
 * for that to come off the site — membership is not something they are in a
 * position to display. The About section made the same claim at greater
 * length and has been rewritten for the same reason.
 */
const { hero } = copy.home;
---

{/* `relative` anchors the backdrop, `isolate` keeps its stacking context
    from reaching the fixed nav, and `overflow-hidden` contains rows that are
    deliberately wider than the page. */}
<section class="relative isolate overflow-hidden">
  <HeroBackdrop />

  <div
    class="relative z-10 mx-auto grid max-w-page gap-12 px-gutter pt-section pb-section lg:grid-cols-[1fr_16rem] lg:gap-16"
  >
    <div class="clearing">
      {/* The tagline, sized as a kicker rather than a second headline.
          Gold-ink rather than gold: this is read, not just seen. */}
      <p class="text-sm font-medium tracking-[0.14em] text-gold-ink uppercase">{hero.eyebrow}</p>

      <h1 class="mt-5 max-w-content font-serif text-display text-ink">{hero.headline}</h1>

      <p class="mt-6 max-w-content text-lg text-ink-muted">{hero.supporting}</p>

      <p class="mt-8 max-w-content border-l-2 border-gold pl-4 text-ink">{hero.process}</p>

      <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-4">
        <a
          href={site.cta.href}
          class="inline-flex min-h-touch items-center rounded-sm bg-accent px-6 font-medium text-accent-contrast transition-colors hover:bg-accent-hover"
        >
          {site.cta.label}
        </a>
        <a
          href="#how-it-works"
          class="inline-flex min-h-touch items-center text-sm text-accent underline underline-offset-4"
        >
          {hero.cta} &#8595;
        </a>
      </div>
    </div>

    <aside class="clearing lg:pt-2">
      <dl class="m-0">
        <div class="border-t-2 border-gold pt-4">
          <dt class="figures text-display-sm text-ink">{allBrands.length}</dt>
          <dd class="m-0 text-sm text-ink-muted">{hero.facts.brands}</dd>
        </div>
      </dl>

      <p class="mt-8 border-t border-line pt-4 text-sm text-ink-muted">{site.responsePromise}</p>
    </aside>
  </div>
</section>

<style>
  /*
   * Two clearings in the backdrop, not one panel over it.
   *
   * The names behind the hero are drifting, so where they cross a line of
   * type the eye reads movement it cannot resolve. A bordered box fixes that
   * but announces itself, and the client rejected it. This instead paints
   * the page's own colour behind the text and blurs its edges away: the
   * names dissolve as they travel under the copy and come back the moment
   * they leave it, with nothing visible marking where.
   *
   * Why `filter: blur()` on a solid rather than a masked gradient: the blur
   * *is* the effect being asked for, it is one declaration rather than three
   * with `mask-composite` and its Safari prefix, and it feathers all four
   * corners evenly, which two crossed linear gradients do not.
   *
   * WHY THE HORIZONTAL NUMBERS ARE SO TIGHT. The copy and the figure are
   * meant to read as two separate clearings with the backdrop alive between
   * them, and the space available for that is fixed: the page is capped at
   * 75rem, the figure column is 16rem, and the copy is capped at the 44rem
   * prose measure — which leaves a 200px band between the end of the text
   * and the start of the figure at every desktop width. Each clearing eats
   * into it twice over, once for its inset and once for the blur, which
   * spreads about 1.5r beyond the shape's own edge. At the previous -4rem
   * and 2rem the two ate 336px of a 200px band and merged into one wash. At
   * -1.5rem and 1rem they eat 96px and leave about 104px of backdrop
   * running between them, while the solid core still reaches the text
   * exactly (24px of inset against 24px of fade).
   *
   * So: change either number and they merge again. The vertical inset is
   * free of all this and stays generous.
   */
  .clearing {
    position: relative;
  }

  /* Behind the text but inside the wrapper's stacking context, so it clears
     the backdrop at `z-0` without needing a z-index of its own up there.
     Width tracks the prose measure rather than the grid cell: the left
     column is `1fr` and runs well past where the text stops, and clearing
     that empty remainder is what closed the gap between the two. */
  .clearing::before {
    content: '';
    position: absolute;
    inset: -3rem auto -3rem -1.5rem;
    width: calc(min(100%, var(--container-content)) + 3rem);
    z-index: -1;
    background-color: var(--color-canvas);
    filter: blur(1rem);
    pointer-events: none;
  }
</style>
