---
/*
 * Curves on a plain page. Nothing else.
 *
 * This has been three things. It drifted the brand names until the client
 * pointed out the marquee 80px below already says them, legibly. It became a
 * field of fine vertical lines — reeded glass — which looked right and moved
 * too little to notice. What survived both is the part that actually moves:
 * five hairline arcs, now over a plain background rather than a texture.
 *
 * They are arcs and not rings because a ring looks identical at every angle
 * and would therefore look still however fast it turned. Three of the four
 * borders are transparent, leaving an open curve with a beginning and an end.
 *
 * Each is far larger than the hero and centred off its edges, so what crosses
 * the page is a curve rather than a circle spinning on it. The durations are
 * primes — 23, 31, 17, 37 and 27 seconds — so the five share no common
 * multiple, never return to the same arrangement, and the hero never visibly
 * loops.
 *
 * **They were three times slower and the client read the hero as still.** A
 * rotation about a centre off the page moves the visible part very little: at
 * 61 seconds the curve drifted about six degrees a second, which a stopwatch
 * finds and an eye does not. If these ever need to calm down, the lever is
 * opacity, not duration — a slower arc does not read as more restrained, it
 * reads as a static line.
 *
 * No top-and-bottom fade. It used to live on this container, and every frame
 * of a rotating arc then recomposited a masked surface the size of the whole
 * hero: 186ms of blocking time and a performance score of 97. The section
 * clips the arcs anyway, and the strip below draws its own border across
 * them, so nothing is lost by leaving it out.
 *
 * `aria-hidden` and `pointer-events: none`: decoration, and it must never
 * intercept a tap meant for the CTA.
 */
const arcs = [
  { size: 46, left: -8, top: -30, duration: 23, reverse: false, gold: false, offset: 0 },
  { size: 62, left: 58, top: -46, duration: 31, reverse: true, gold: true, offset: 14 },
  { size: 34, left: 22, top: 30, duration: 17, reverse: true, gold: false, offset: 9 },
  { size: 58, left: 12, top: -44, duration: 37, reverse: false, gold: false, offset: 31 },
  { size: 40, left: 74, top: 22, duration: 27, reverse: false, gold: true, offset: 22 },
];
---

<div class="backdrop" aria-hidden="true">
  {
    arcs.map((arc) => (
      <div
        class:list={['arc', arc.gold && 'arc-gold']}
        style={`width:${arc.size}rem;height:${arc.size}rem;left:${arc.left}%;top:${arc.top}%;animation-duration:${arc.duration}s;animation-direction:${arc.reverse ? 'reverse' : 'normal'};animation-delay:-${arc.offset}s`}
      />
    ))
  }
</div>

<style>
  .backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    user-select: none;

    /* Nothing inside affects layout outside, and the browser can skip the
       whole thing once it is scrolled past. */
    contain: strict;
  }

  .arc {
    position: absolute;
    /* 2px, not 1. A hairline reads as a hairline on a rule a few inches
       long; on a curve this large it disappears, and a movement nobody can
       see is not movement. */
    border: 2px solid transparent;
    border-top-color: var(--color-ink);
    border-right-color: var(--color-ink);
    border-radius: 50%;
    opacity: 0.12;
    animation-name: turn;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }

  /* No `will-change` on purpose. A transform animation is promoted to the
     compositor while it runs whether or not it is declared, and these are
     large — the biggest is 62rem square, which on a 3x phone is a texture
     worth tens of megabytes. Declaring it would pin all five of those layers
     for the life of the page rather than only while they are on screen. */
  .arc-gold {
    border-top-color: var(--color-gold);
    border-right-color: var(--color-gold);
    opacity: 0.26;
  }

  @keyframes turn {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .arc {
      animation: none;
    }
  }
</style>
