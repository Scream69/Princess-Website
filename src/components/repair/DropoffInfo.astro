---
import copy from '../../data/copy.json';
import site from '../../data/site.json';

// Where to bring it. Static — no JS needed — and shown throughout the
// booking so the address is never more than a scroll away, not just on the
// confirmation screen.
const { dropoff } = copy.repairs;
---

<aside class="mt-10 max-w-content rounded-sm border border-line bg-surface p-5" aria-label={dropoff.heading}>
  <p class="text-sm font-medium tracking-wide text-ink-muted uppercase">{dropoff.heading}</p>
  <p class="mt-2 text-ink">{site.contact.shopAddress}</p>

  <p class="mt-4 text-sm font-medium tracking-wide text-ink-muted uppercase">{dropoff.hoursHeading}</p>
  <ul class="mt-2 list-none space-y-1 p-0 text-sm text-ink">
    {site.hours.map((block) => <li>{block.label}, {block.opens}–{block.closes}</li>)}
  </ul>

  <p class="mt-4 text-sm text-ink-muted">{dropoff.workshopNote}</p>
</aside>
