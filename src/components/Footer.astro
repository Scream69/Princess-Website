---
import site from '../data/site.json';
import copy from '../data/copy.json';
import { isPlaceholder, legalName, telHref } from '../data/site';
// See the note in Nav.astro — `?url` keeps the two lockups' gradient ids apart.
import logoStacked from '../assets/logo-stacked.svg?url';

const year = new Date().getFullYear();

/*
 * The telephone number is not supplied yet (MISSING-ASSETS 4). While it is a
 * marker, the number is still shown — it is a visible reminder to the client,
 * and the site is not indexed yet — but it is not wrapped in a `tel:` link.
 * A dead `tel:` is worse than no link: on a phone it is a full-width tap
 * target that opens the dialler with a placeholder in it. `site.ts` already
 * takes this position for WhatsApp, where the button renders nothing rather
 * than a broken `wa.me` href; this is the same rule applied consistently.
 */
const phone = site.contact.phone;
const phoneIsReal = !isPlaceholder(phone);
---

<footer id="contact" class="mt-section border-t border-line bg-surface">
  <div class="mx-auto max-w-page px-gutter py-12">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
      <div>
        {/* The lockup is the mark plus the line under it, sized as one thing.
            It is `inline-grid`, so its width is the tagline's — and the mark
            is told to contribute nothing to that measurement and then fill
            it, which is what keeps the two the same width without a number
            in the stylesheet. The tagline lives in site.json and the client
            will change it (rule 9); a hardcoded width would quietly stop
            matching on the day they do. */}
        <div class="lockup">
          <h2>
            <img src={logoStacked} alt={site.name} width="169" height="166" loading="lazy" />
          </h2>
          <p class="mt-2 text-sm text-ink-muted">{site.tagline}</p>
        </div>
        <p class="mt-4 text-sm text-ink-muted">{site.responsePromise}</p>
      </div>

      <div>
        <h2 class="text-sm font-medium tracking-wide text-ink uppercase">Contact</h2>
        <ul class="mt-3 space-y-2 text-sm text-ink-muted">
          <li>
            <a class="tap-target hover:text-ink" href={`mailto:${site.contact.email}`}>
              {site.contact.email}
            </a>
          </li>
          <li>
            {
              phoneIsReal ? (
                <a class="tap-target hover:text-ink" href={telHref}>
                  {phone}
                </a>
              ) : (
                <span>{phone}</span>
              )
            }
          </li>
          {
            /* Only the days the client gave us. Sunday is absent rather than
               marked closed — they did not say it is, and opening hours are a
               business fact, not something to infer from a gap in a list. */
            site.hours.map((block) => (
              <li>
                {block.label}, {block.opens}–{block.closes}
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="text-sm font-medium tracking-wide text-ink uppercase">Company</h2>
        <ul class="mt-3 space-y-2 text-sm text-ink-muted">
          <li>{legalName}</li>
          <li>Registered in England and Wales, {site.company.registrationNumber}</li>
          <li>VAT {site.company.vatNumber}</li>
          <li>{site.company.registeredAddress}</li>
        </ul>
      </div>
    </div>

    <div
      class="mt-10 flex flex-col gap-3 border-t border-line pt-6 text-sm text-ink-subtle sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {year} {legalName}. All rights reserved.</p>
      <ul class="flex gap-5">
        <li>
          <a class="inline-flex min-h-touch items-center hover:text-ink" href="/privacy">Privacy policy</a>
        </li>
      </ul>
    </div>

    <p class="mt-6 max-w-content text-xs text-ink-subtle">{copy.footer.note}</p>
  </div>
</footer>

<style>
  .lockup {
    /* `inline-grid` shrinks to fit its widest item. With the mark excluded
       from that measurement below, the widest item is the tagline — capped
       below so the mark stays a compact footer mark rather than growing to
       match the (much longer) Contact/Company columns beside it. */
    display: inline-grid;
    max-width: 8rem;
  }

  .lockup img {
    /* `width: 0` makes the image contribute nothing when the grid measures
       itself; `min-width: 100%` then fills whatever width the tagline set.
       Percentages in `min-width` are ignored during intrinsic sizing, which
       is exactly why this resolves instead of chasing itself in a circle. */
    width: 0;
    min-width: 100%;
    height: auto;
  }

  /*
   * The mailto/tel links sit in the same list as plain-text lines (the
   * opening hours). Giving them `min-h-touch` directly, as every other link
   * on the site does, stretched those two rows to 44px while their
   * neighbours stayed text-height — the list read as raggedly spaced. This
   * keeps every row the same height and instead grows the *hit area* only,
   * via an invisible pseudo-element, so the 44px touch target (CLAUDE.md 9.5)
   * costs nothing visually.
   */
  .tap-target {
    position: relative;
    display: inline-block;
  }

  .tap-target::before {
    content: '';
    position: absolute;
    inset: -0.75rem -0.5rem;
  }
</style>
