---
import copy from '../../data/copy.json';

// One tray, in step 2. Step 3 shows the same items again as a review summary,
// rendered by the wizard rather than by a second component.
---

<section data-tray hidden class="mt-8 rounded-sm border border-line bg-surface p-4">
  <h3 class="text-sm font-medium tracking-wide text-ink-muted uppercase">
    {copy.order.trayHeading} (<span data-tray-count>0</span>)
  </h3>
  <ul data-tray-list class="mt-2 list-none p-0"></ul>
</section>
