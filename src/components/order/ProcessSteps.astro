---
import copy from '../../data/copy.json';

/*
 * The whole model, in three lines, above the brand grid on step 1. First-time
 * visitors have to understand that they leave for the manufacturer's site and
 * come back with a link before they start clicking brands — otherwise step 2
 * arrives as a surprise.
 *
 * Kept deliberately short: the detail that matters at each point is repeated
 * in that step's own explanation, and the brand grid is the centrepiece of
 * this page (CLAUDE.md 9.4) so it must not be pushed far down on a phone.
 *
 * Phase 7's home-page "How it works" mirrors the same sequence and should read
 * from `copy.order.process` rather than restating it.
 */
const { process } = copy.order;
---

<section aria-labelledby="process-heading" class="mt-8 border-t border-line pt-6">
  <h3 id="process-heading" class="text-sm font-medium tracking-wide text-ink-muted uppercase">
    {process.heading}
  </h3>

  <ol class="mt-4 grid list-none gap-x-8 gap-y-5 p-0 sm:grid-cols-3">
    {
      process.steps.map((step, index) => (
        <li class="max-w-content">
          <p class="flex items-baseline gap-2">
            {/* Decorative: the ordered list already conveys the sequence. */}
            <span aria-hidden="true" class="font-serif text-lg text-accent">{index + 1}</span>
            <span class="font-medium text-ink">{step.title}</span>
          </p>
          <p class="mt-1 text-sm text-ink-muted">{step.detail}</p>
        </li>
      ))
    }
  </ol>
</section>
