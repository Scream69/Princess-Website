---
import Tray from './Tray.astro';

// Step 2. Phase 3 gives this step a plain text input so items can reach the
// tray and the add-another loop is exercisable. Clipboard return-detection,
// the global paste listener and model-number parsing are Phase 4
// (CLAUDE.md 8.1, 8.3) — deliberately absent, not forgotten.
---

<section data-step-panel="2" hidden>
  <h2
    data-step-heading
    tabindex="-1"
    class="mt-6 max-w-content font-serif text-heading text-ink focus:outline-none"
  >
    Add your appliance
  </h2>

  <div data-brand-chosen hidden class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1">
    <p class="text-ink-muted">
      Brand: <span data-brand-name class="font-medium text-ink"></span>
    </p>
    <a
      data-brand-link
      href="#"
      target="_blank"
      rel="noopener noreferrer"
      class="text-sm text-accent underline underline-offset-4"></a>
  </div>

  <p class="mt-4 max-w-content text-ink-muted">
    Copy the product page link from the manufacturer's site, or type the model number.
    Either is enough for us to quote.
  </p>

  <form data-add-item class="mt-6 max-w-content">
    <label for="product" class="block text-sm font-medium text-ink">
      Product link or model number
    </label>
    <div class="mt-2 flex flex-col gap-2 sm:flex-row">
      <input
        id="product"
        name="product"
        type="text"
        required
        autocomplete="off"
        placeholder="https://…  or  H7860BPX"
        class="h-touch min-w-0 flex-1 rounded-sm border border-line-strong bg-surface px-3 text-ink placeholder:text-ink-subtle"
      />
      <button
        type="submit"
        class="h-touch shrink-0 rounded-sm bg-accent px-6 font-medium text-accent-contrast transition-colors hover:bg-accent-hover"
      >
        Add
      </button>
    </div>
  </form>

  <Tray />

  <div class="mt-8 flex flex-wrap gap-3">
    <button
      type="button"
      data-action="add-another"
      class="min-h-touch rounded-sm border border-line-strong px-6 font-medium text-ink transition-colors hover:border-ink"
    >
      Add another appliance
    </button>
    <button
      type="button"
      data-action="go-step"
      data-step="3"
      data-continue-details
      disabled
      class="min-h-touch rounded-sm bg-accent px-6 font-medium text-accent-contrast transition-colors hover:bg-accent-hover disabled:cursor-not-allowed disabled:opacity-40"
    >
      Continue to your details
    </button>
  </div>
</section>
