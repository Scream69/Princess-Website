---
import copy from '../../data/copy.json';
import Tray from './Tray.astro';

// Step 2 — the step the whole site exists for: get a usable model number back
// from the manufacturer's site (CLAUDE.md 1). Three ways forward, all valid: a
// pasted link, a typed model number, or free text. None of them is a gate.
//
// The explanation above the field spells out the copy-and-paste, because it is
// the one thing a first-time customer has to do that no other website asks of
// them. Nothing here describes pasting as automatic — it cannot be (8.1).
const { step2 } = copy.order;
---

<section data-step-panel="2" hidden>
  <h2
    data-step-heading
    tabindex="-1"
    class="mt-6 max-w-content font-serif text-heading text-ink focus:outline-none"
  >
    {step2.heading}
  </h2>

  <div data-brand-chosen hidden class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1">
    <p class="text-ink-muted">
      {step2.brandLabel}: <span data-brand-name class="font-medium text-ink"></span>
    </p>
    <a
      data-brand-link
      href="#"
      target="_blank"
      rel="noopener noreferrer"
      class="text-sm text-accent underline underline-offset-4"></a>
  </div>

  <p class="mt-4 max-w-content text-ink-muted">{step2.intro}</p>
  <p class="mt-3 max-w-content text-sm text-ink-muted">{step2.alternatives}</p>

  <form data-add-item class="mt-6 max-w-content">
    {/* Shown only on returning to this tab, and only while the field is empty.
        Not automatic, and never described as such (CLAUDE.md 8.1). */}
    <button
      type="button"
      data-paste-button
      hidden
      class="mb-4 flex min-h-touch w-full items-center justify-center rounded-sm border border-accent bg-accent px-6 font-medium text-accent-contrast transition-colors hover:bg-accent-hover"
    >
      {step2.pasteButton}
    </button>

    <label for="product" class="block text-sm font-medium text-ink">{step2.inputLabel}</label>
    <div class="mt-2 flex flex-col gap-2 sm:flex-row">
      <input
        id="product"
        name="product"
        type="text"
        required
        autocomplete="off"
        spellcheck="false"
        placeholder={step2.inputPlaceholder}
        aria-describedby="product-echo"
        class="h-touch min-w-0 flex-1 rounded-sm border border-line-strong bg-surface px-3 text-ink placeholder:text-ink-subtle"
      />
      <button
        type="submit"
        class="h-touch shrink-0 rounded-sm bg-accent px-6 font-medium text-accent-contrast transition-colors hover:bg-accent-hover"
      >
        {step2.add}
      </button>
    </div>

    {/* What we understood, echoed back before it is committed (CLAUDE.md 8.3). */}
    <p id="product-echo" data-echo aria-live="polite" class="mt-2 min-h-5 text-sm text-ink-muted"></p>
  </form>

  <details class="mt-4 max-w-content">
    <summary class="cursor-pointer text-sm text-accent underline underline-offset-4">
      {step2.describeSummary}
    </summary>
    <form data-add-description class="mt-3">
      <label for="description" class="block text-sm font-medium text-ink">
        {step2.describeLabel}
      </label>
      <textarea
        id="description"
        name="description"
        rows="3"
        required
        placeholder={step2.describePlaceholder}
        class="mt-2 block w-full rounded-sm border border-line-strong bg-surface p-3 text-ink placeholder:text-ink-subtle"
      ></textarea>
      <button
        type="submit"
        class="mt-3 min-h-touch rounded-sm border border-line-strong px-6 font-medium text-ink transition-colors hover:border-ink"
      >
        {step2.describeAdd}
      </button>
    </form>
  </details>

  <Tray />

  <div class="mt-8 flex flex-wrap gap-3">
    <button
      type="button"
      data-action="add-another"
      class="min-h-touch rounded-sm border border-line-strong px-6 font-medium text-ink transition-colors hover:border-ink"
    >
      {step2.addAnother}
    </button>
    <button
      type="button"
      data-action="go-step"
      data-step="3"
      data-continue-details
      disabled
      class="min-h-touch rounded-sm bg-accent px-6 font-medium text-accent-contrast transition-colors hover:bg-accent-hover disabled:cursor-not-allowed disabled:opacity-40"
    >
      {step2.continue}
    </button>
  </div>
</section>
