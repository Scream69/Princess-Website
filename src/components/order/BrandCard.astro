---
import { firstLetter, type LinkableBrand } from '../../data/brands';

interface Props {
  brand: LinkableBrand;
  /** True for the first brand under each initial — carries the A–Z rail's scroll target. */
  isFirstOfLetter: boolean;
}

const { brand, isFirstOfLetter } = Astro.props;
const letter = firstLetter(brand.name);

/*
 * Every logo file is the same 280x88 canvas with the mark already scaled to a
 * constant optical weight inside it (scripts/prepare-logos.mjs), so the card
 * can render them all in one identical box and they come out looking the same
 * size — which is the whole point of CLAUDE.md 9.4 and the thing that fitting
 * each mark to the same width fails to do.
 *
 * `opticalScale` stays wired as the escape hatch for a mark the automatic
 * normalisation still gets wrong. It is 1 for every brand today; set it on the
 * one record that needs it rather than nudging the pipeline for everyone.
 *
 * Width and height are the intrinsic pixel size, not the rendered size, so the
 * browser reserves the right box before the file arrives (CLS, 10.2).
 */
const logoUrl = brand.logo ? `/brands/${brand.logo}` : null;
---

<a
  data-brand-card
  data-name={brand.name}
  data-slug={brand.slug}
  data-letter={letter}
  data-categories={brand.categories.join(' ')}
  id={isFirstOfLetter ? `letter-${letter}` : undefined}
  href={brand.url}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`${brand.name} — view range on the manufacturer's site (opens in a new tab)`}
  class="group relative flex min-h-32 flex-col items-center justify-center gap-2 rounded-sm border border-line bg-surface px-4 py-6 transition-[transform,border-color] duration-150 hover:-translate-y-0.5 hover:border-line-strong focus-visible:-translate-y-0.5"
  style={`--optical-scale:${brand.opticalScale}`}
>
  {
    logoUrl ? (
      <img
        src={logoUrl}
        alt=""
        width="280"
        height="88"
        loading="lazy"
        decoding="async"
        class="h-11 w-full origin-center object-contain"
        style="scale: var(--optical-scale)"
      />
    ) : (
      <span
        aria-hidden="true"
        class="text-center font-serif text-lg leading-tight text-ink origin-center"
        style="scale: var(--optical-scale)"
      >
        {brand.name}
      </span>
    )
  }

  <span
    aria-hidden="true"
    class="text-xs text-ink-subtle opacity-0 transition-opacity duration-150 group-hover:opacity-100 group-focus-visible:opacity-100"
  >
    View range &#8599;
  </span>
</a>
