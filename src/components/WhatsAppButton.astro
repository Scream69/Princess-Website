---
import copy from '../data/copy.json';
import { whatsappHref } from '../data/site';
import WhatsAppIcon from './WhatsAppIcon.astro';

/*
 * The floating button, on every page (CLAUDE.md 7).
 *
 * `whatsappHref()` is null until a number is in site.json, and the button is
 * withheld rather than rendered dead — a customer whose enquiry has just
 * failed tapping the one thing left that could save it and landing nowhere is
 * the worst version of rule 2.4. The number landed 2026-09-15.
 *
 * On the home page it does not appear straight away. The hero has its own
 * WhatsApp button beside the quote button, and a floating bubble on top of
 * that is the same offer twice, covering the page's own call to action while
 * it does so. It waits for a cue placed half way down the how-it-works
 * section — the reader has committed by then — and fades in there.
 *
 * Pages with no cue show it immediately, which is deliberate rather than a
 * fallback: on `/order` this link is the escape hatch for an enquiry that
 * cannot be sent (8.7 step 4), and delaying it would be actively harmful.
 */
const href = whatsappHref();
---

{
  href && (
    <a
      data-whatsapp-float
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      class="fixed right-4 bottom-4 z-50 inline-flex min-h-touch min-w-touch items-center gap-2 rounded-sm border border-line bg-surface px-4 text-sm font-medium text-ink transition-colors hover:border-line-strong"
    >
      <WhatsAppIcon />
      <span>{copy.whatsapp.floating}</span>
    </a>
  )
}

<style>
  /*
   * How it arrives. *Whether* it waits at all is decided in HowItWorks.astro,
   * because that section owns the cue — see the note there.
   */
  [data-whatsapp-float] {
    transition:
      opacity 240ms ease,
      transform 240ms ease,
      visibility 0s;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-whatsapp-float] {
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  /*
   * Reveal on a cue rather than on a scroll position, so nothing here has to
   * know how tall the how-it-works section is — the cue sits at 50% of it and
   * moves when the section does.
   *
   * The root is stretched 100,000px downward, and that is the whole trick.
   * An observer only reports when an element *crosses* the root's edge, so a
   * 1px cue observed against the plain viewport is silent whenever the scroll
   * jumps over it — and this page jumps: the nav's "Brands" anchor leaps from
   * the hero to well past this section in one go, and the first version of
   * this left the button hidden the whole way. With the root extended, the
   * cue is inside it at every position below the fold and leaves it only by
   * passing the top of the viewport, so `isIntersecting` becomes a clean
   * binary that changes exactly once, at the point we care about, and fires
   * however abruptly the page got there.
   */
  const button = document.querySelector<HTMLElement>('[data-whatsapp-float]');
  const cue = document.querySelector('[data-whatsapp-cue]');

  if (button) {
    if (!cue) {
      button.dataset.shown = '';
    } else {
      const observer = new IntersectionObserver(
        ([entry]) => {
          if (!entry) return;
          // Outside the extended root can only mean "above the viewport".
          if (entry.isIntersecting) delete button.dataset.shown;
          else button.dataset.shown = '';
        },
        { rootMargin: '0px 0px 100000px 0px', threshold: 0 },
      );

      observer.observe(cue);
    }
  }
</script>
