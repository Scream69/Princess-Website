---
/*
 * One copy of the mark, used by the hero button and the floating one. It was
 * a single inline path until there were two buttons; two copies of a 600-
 * character `d` attribute is exactly the sort of thing that drifts.
 *
 * `currentColor` so it takes the colour of whichever button holds it, and
 * `aria-hidden` because every caller already has a text label beside it.
 */
interface Props {
  size?: number;
}

const { size = 18 } = Astro.props;
---

<svg aria-hidden="true" width={size} height={size} viewBox="0 0 24 24" fill="currentColor">
  <path
    d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.97L2 22l5.25-1.38a9.87 9.87 0 0 0 4.79 1.22c5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2Zm5.8 14.06c-.24.68-1.4 1.3-1.93 1.35-.53.05-1.03.24-2.9-.6-2.24-1-3.65-3.36-3.76-3.51-.11-.16-.9-1.22-.9-2.33s.58-1.65.79-1.88c.2-.23.44-.29.59-.29.15 0 .3 0 .43.01.14.01.32-.05.5.38.18.44.63 1.54.68 1.65.05.11.09.24.02.39-.08.15-.15.24-.29.38-.14.14-.29.31-.42.42-.14.11-.28.24-.13.5.15.26.67 1.11 1.44 1.8.99.88 1.66 1.09 1.9 1.21.24.12.38.1.52-.06.14-.16.6-.7.76-.94.16-.24.32-.2.54-.12.22.08 1.4.66 1.64.78.24.12.4.18.46.28.06.1.06.6-.18 1.28Z"
  ></path>
</svg>
