---
import site from '../data/site.json';

/*
 * LocalBusiness structured data (CLAUDE.md 10.4).
 *
 * Every field here is a business fact, so the block is emitted only once the
 * facts are real: anything still carrying an `[AWAITING …]` marker is left
 * out, and if the essentials are missing the whole script is omitted. Search
 * engines penalise structured data that contradicts the page, and a
 * placeholder company name in machine-readable form is worse than none at all
 * (rule 2.2).
 *
 * Address, telephone and opening hours are what make this worth having for
 * local search. All three landed on 2026-09-15.
 */
const supplied = (value: string): string | null =>
  value && !value.startsWith('[AWAITING') && !value.startsWith('[BLOCKED') ? value : null;

const name = supplied(site.name);
const legalName = supplied(site.legalName);
const email = supplied(site.contact.email);
const telephone = supplied(site.contact.phone);
const address = supplied(site.company.registeredAddress);
const vat = supplied(site.company.vatNumber);

/*
 * schema.org wants days and 24-hour times, which is exactly the shape
 * `site.hours` is stored in — the footer's readable version is rendered from
 * the same records, so the two can never disagree.
 */
const openingHours = site.hours.map((block) => ({
  '@type': 'OpeningHoursSpecification',
  dayOfWeek: block.days,
  opens: block.opens,
  closes: block.closes,
}));

// A name and a way to reach them is the minimum that says anything true.
const ready = Boolean(name && (email || telephone));

const data = ready
  ? {
      '@context': 'https://schema.org',
      '@type': 'LocalBusiness',
      name,
      ...(legalName ? { legalName } : {}),
      ...(email ? { email } : {}),
      ...(telephone ? { telephone } : {}),
      ...(address ? { address: { '@type': 'PostalAddress', streetAddress: address } } : {}),
      ...(vat ? { vatID: vat } : {}),
      ...(openingHours.length ? { openingHoursSpecification: openingHours } : {}),
      ...(Astro.site ? { url: Astro.site.href } : {}),
    }
  : null;
---

{
  data && (
    <script
      type="application/ld+json"
      is:inline
      set:html={
        /*
         * `JSON.stringify` escapes quotes and backslashes but not `<`, and
         * this string is written inside a `<script>` element — so a value
         * containing `</script>` closes the block early and everything after
         * it is parsed as markup, in the head of every page. The values come
         * from site.json, which rule 9 designates as the file the client
         * edits, so this is one careless paste away rather than hypothetical.
         *
         * Escaping `<` as `\u003c` is invisible to a JSON parser and makes
         * the sequence unwritable. `\u2028`/`\u2029` go with it: both are
         * valid in JSON and both terminate a line in JavaScript.
         */
        JSON.stringify(data)
          .replace(/</g, '\\u003c')
          .replace(/\u2028/g, '\\u2028')
          .replace(/\u2029/g, '\\u2029')
      }
    />
  )
}
