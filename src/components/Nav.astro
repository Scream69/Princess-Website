---
import site from '../data/site.json';
// `?url` rather than a bare import: Astro would otherwise inline the SVG, and
// both lockups declare gradient ids id0…idN. Inlined together on one page the
// footer's gradients would resolve against the nav's. An <img> keeps each SVG
// its own document, so the ids stay scoped.
import logoHorizontal from '../assets/logo-horizontal.svg?url';

interface Props {
  showLinks?: boolean;
}

const { showLinks = true } = Astro.props;
---

<header
  class="fixed inset-x-0 top-0 z-50 border-b border-line bg-canvas/95 backdrop-blur-sm"
>
  <nav
    class="mx-auto flex h-16 max-w-page items-center justify-between gap-4 px-gutter"
    aria-label="Main"
  >
    <a
      href="/"
      class="inline-flex min-h-touch min-w-0 items-center transition-opacity hover:opacity-80"
    >
      <img
        src={logoHorizontal}
        alt={site.name}
        class="h-7 w-auto sm:h-8"
        width="374"
        height="81"
      />
    </a>

    <div class="flex shrink-0 items-center gap-2">
      {
        showLinks && (
          <ul class="hidden items-center gap-6 md:flex">
            {site.nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="inline-flex min-h-touch items-center text-sm text-ink-muted transition-colors hover:text-ink"
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        )
      }

      <a
        href={site.cta.href}
        class="inline-flex min-h-touch items-center rounded-sm bg-accent px-4 text-sm font-medium whitespace-nowrap text-accent-contrast transition-colors hover:bg-accent-hover"
      >
        {site.cta.label}
      </a>

      {
        showLinks && (
          <button
            type="button"
            id="nav-toggle"
            class="inline-flex min-h-touch min-w-touch items-center justify-center text-ink md:hidden"
            aria-expanded="false"
            aria-controls="nav-menu"
          >
            <span class="sr-only">Menu</span>
            <svg
              aria-hidden="true"
              width="20"
              height="20"
              viewBox="0 0 20 20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path d="M2.5 5.5h15M2.5 10h15M2.5 14.5h15" />
            </svg>
          </button>
        )
      }
    </div>
  </nav>

  {
    showLinks && (
      <div id="nav-menu" class="border-t border-line bg-canvas md:hidden" hidden>
        <ul class="mx-auto max-w-page px-gutter py-2">
          {site.nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="flex min-h-touch items-center text-ink-muted hover:text-ink"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</header>

<!-- Spacer: the nav is fixed, so content needs its height back. -->
<div class="h-16" aria-hidden="true"></div>

<script>
  // The only JS the home page ships beyond the WhatsApp button
  // (CLAUDE.md 10.2). Deliberately tiny and framework-free.
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-menu');

  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      menu.hidden = open;
    });

    // Close on navigation to an in-page anchor, so the menu does not
    // cover the section the customer just chose.
    menu.addEventListener('click', (event) => {
      if (event.target instanceof HTMLAnchorElement) {
        toggle.setAttribute('aria-expanded', 'false');
        menu.hidden = true;
      }
    });
  }
</script>
