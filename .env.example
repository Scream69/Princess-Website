# Copy to .env and fill in. Never commit .env.

# Web3Forms access key — receives the enquiry POST (CLAUDE.md 8.7).
# Obtain from https://web3forms.com after the client's destination
# email address is confirmed.
PUBLIC_WEB3FORMS_KEY=

# Cookieless analytics (Plausible or Umami — CLAUDE.md 2.6).
# The domain registered with the analytics provider.
PUBLIC_ANALYTICS_DOMAIN=
# Self-hosted or provider script URL.
PUBLIC_ANALYTICS_SRC=
