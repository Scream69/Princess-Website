# Copy to .env and fill in. Never commit .env.

# Web3Forms access key — receives the enquiry POST (CLAUDE.md 8.7).
# Obtain from https://web3forms.com after the client's destination
# email address is confirmed.
#
# With this empty, nothing is posted: the enquiry is queued in the browser and
# the customer is told honestly that it has not been sent. Locally, any
# non-empty value enables the delivery checks in `npm run test:e2e`, which stub
# every request — restart the dev server after changing it.
PUBLIC_WEB3FORMS_KEY=

# Cookieless analytics (Plausible or Umami — CLAUDE.md 2.6). Both are set, or
# neither: with either blank, no provider script is requested at all and the
# event helpers become no-ops. No cookie banner is required for either.
#
# The site identifier the provider issued — Plausible's domain, or Umami's
# website id. It is rendered into both data attributes; each script reads only
# its own.
PUBLIC_ANALYTICS_DOMAIN=
# The provider script URL, e.g. https://plausible.io/js/script.js
PUBLIC_ANALYTICS_SRC=
